# SmartServe AI Configuration

# Optional: Google Gemini API key for conversational LLM features.
# If omitted, SmartServe AI automatically operates in offline deterministic mode with 100% functionality.
GEMINI_API_KEY=

# Database URL (Default SQLite)
DATABASE_URL=sqlite:///backend/smartserve.db

# Server ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
